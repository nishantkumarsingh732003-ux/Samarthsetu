# ---------- App ----------
APP_NAME=setu
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ---------- Security ----------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Database ----------
POSTGRES_USER=saarthi
POSTGRES_PASSWORD=saarthi
POSTGRES_DB=saarthi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://saarthi:saarthi@localhost:5432/saarthi

# ---------- Cache / queue ----------
REDIS_URL=redis://localhost:6379/0

# ---------- LLM (optional) ----------
# The LLM never decides eligibility — it extracts facts before the rule engine and
# restates its reasons after. Leaving every key blank is a supported configuration:
# extraction falls back to the deterministic parser and explanations to templates.
#
# LLM_PROVIDER: auto | anthropic | xai | groq | none
#   auto  - use whichever key below is set (groq, then xai, then anthropic)
#   none  - never call a model, even if a key is present
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=

# xAI serves the Grok models. Keys look like xai-...
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Groq is a DIFFERENT company: open models (Llama, Qwen, ...) on its own inference
# hardware. Keys look like gsk_... Do not confuse it with Grok above.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq's catalogue changes often. Verified working 2026-08-29:
#   qwen/qwen3.8-27b      text + tool calling (the default)
#   openai/gpt-oss-120b   tool calling; a reasoning model, needs max_tokens room
#   groq/compound-mini    text only, NO tool calling — extraction would degrade
# List what your key can reach: docker compose exec api python /scripts/check_llm.py

# Blank uses the provider default. Confirm the current model id with your provider —
# these names change. Check with: docker compose exec api python /scripts/check_llm.py
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ---------- Documents and consent (DPDP Act 2023) ----------
# Where redacted document bytes are written. Compose overrides this to a named volume.
STORAGE_DIR=./var/uploads
# Salt for the government-ID hash. Set this to a long random string in any deployment;
# blank falls back to SECRET_KEY, which is fine for a dev clone and not for anything else.
# Rotating it deliberately breaks de-duplication of existing rows — the old hashes stop
# being meaningful, which is the correct behaviour.
ID_HASH_SALT=
CONSENT_POLICY_VERSION=2026-08-01

# ---------- Notifications and reach ----------
# database | console | sms | whatsapp. `database` renders the message and stores it for
# the citizen to read on their tracking page — no contact address, no network, no
# third party, which is why the demo runs on it. The sms and whatsapp drivers implement
# the same interface and refuse rather than pretend: SamarthSetu stores only the last four
# digits of a phone number, so there is nothing to dial (see OPEN_ITEMS OI-43).
NOTIFICATION_DRIVER=database
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Used to build the tracking link inside a notification.
PUBLIC_WEB_URL=http://localhost:3000

# ---------- Hardening ----------
# Fixed-window per client, per route group. Generous by design: the point is to stop a
# runaway script, not to ration a citizen who taps twice on a bad connection. Fails
# OPEN — if Redis is unreachable the request is served rather than refused.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_CONVERSATION=30
RATE_LIMIT_LOGIN=10
# One JSON object per line. Prose logs are pleasant on a laptop and useless in a
# container, where the question is always "what happened to request X".
LOG_JSON=true

# ---------- Geo ----------
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=setu

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=en
