# Normalise line endings. Shell scripts and Dockerfiles run inside Linux containers,
# so a CRLF checkout on Windows makes the shebang `#!/usr/bin/env bash\r` unresolvable
# and the container dies with "bad interpreter". Force LF for everything Linux executes.
* text=auto eol=lf

*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
entrypoint.sh   text eol=lf
*.sql           text eol=lf

# Generated artefact — keep the diff readable but do not let editors reflow it.
packages/rules/dist/rules.json      text eol=lf
packages/rules/tests/golden/*.json  text eol=lf

*.png binary
*.jpg binary
*.pdf binary
